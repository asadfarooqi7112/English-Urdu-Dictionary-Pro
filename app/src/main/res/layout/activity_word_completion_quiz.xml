<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_light_background"
    tools:context=".activities.WordCompletionQuizActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/topBarWordCompletion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvWordCompletionQuestionCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/word_progress"
                    android:textSize="18sp"
                    android:textColor="@color/quiz_text_muted" />

                <TextView
                    android:id="@+id/tvWordCompletionScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_progress"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/quiz_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWordCompletionInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_word_prompt"
                android:textSize="20sp"
                android:textStyle="italic"
                android:layout_marginTop="16dp"
                android:textColor="@color/quiz_text_primary"
                android:gravity="center" />

            <androidx.cardview.widget.CardView
                android:id="@+id/wordCompletionMeaningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/quiz_card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:contentPadding="20dp">

                <TextView
                    android:id="@+id/tvWordCompletionMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/meaning_placeholder"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:gravity="center"
                    android:textColor="@color/quiz_text_primary" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvWordCompletionMaskedWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/word"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/quiz_text_primary"
                android:gravity="center"
                android:padding="8dp"/>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/llWordCompletionOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:flexWrap="nowrap"
                app:justifyContent="space_around"
                app:alignItems="center"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/tvWordCompletionMaskedWord"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:id="@+id/tvWordCompletionFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:gravity="center_horizontal"
                android:textStyle="italic"
                android:layout_marginTop="16dp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btnWordCompletionNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_word"
                android:textSize="20sp"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/quiz_button_bg"
                android:textColor="@color/quiz_button_text"
                android:elevation="6dp"
                app:cornerRadius="24dp"
                android:visibility="invisible" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>