<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_light_background"
    tools:context=".activities.SpellingQuizActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/topBarSpelling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvSpellingQuestionCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/spelling_progress"
                    android:textSize="18sp"
                    android:textColor="@color/quiz_text_muted" />
                <TextView
                    android:id="@+id/tvSpellingScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_progress"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/quiz_text_primary" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvSpellingInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spell_word_instruction"
                android:textSize="20sp"
                android:textStyle="italic"
                android:layout_marginTop="16dp"
                android:textColor="@color/quiz_text_primary"
                android:gravity="center" />
            <androidx.cardview.widget.CardView
                android:id="@+id/spellingMeaningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/quiz_card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:contentPadding="20dp">
                <TextView
                    android:id="@+id/tvSpellingChallengeMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/meaning_placeholder"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:gravity="center"
                    android:textColor="@color/quiz_text_primary" />
            </androidx.cardview.widget.CardView>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/llLetterBoxesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/edittext_background_quiz"
                app:flexWrap="wrap"
                app:justifyContent="center"
                app:alignItems="center">
            </com.google.android.flexbox.FlexboxLayout>
            <Button
                android:id="@+id/btnSpellingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_hint"
                android:textSize="20sp"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/quiz_hint_button_bg_soft"
                android:textColor="@color/quiz_hint_button_text_dark"
                android:elevation="6dp"
                app:cornerRadius="8dp"
                android:visibility="visible" />
            <Button
                android:id="@+id/btnSpellingSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/submit_answer"
                android:textSize="20sp"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/quiz_button_bg"
                android:textColor="@color/quiz_button_text"
                android:elevation="6dp"
                app:cornerRadius="8dp" />
            <TextView
                android:id="@+id/tvSpellingFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:gravity="center_horizontal"
                android:textStyle="italic"
                android:layout_marginTop="16dp"
                android:visibility="invisible" />
            <Button
                android:id="@+id/btnSpellingNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_word"
                android:textSize="20sp"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/quiz_button_bg"
                android:textColor="@color/quiz_button_text"
                android:elevation="6dp"
                app:cornerRadius="24dp"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>