<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_background"
    tools:context=".activities.TimedQuizActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/llQuizInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"> <TextView
        android:id="@+id/tvTimedQuizQuestionCounter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/word_progress"
        android:textColor="@color/quiz_text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTimedQuizTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/timer"
            android:textColor="@color/quiz_text_accent"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTimedQuizScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/score_progress"
            android:textColor="@color/quiz_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarTimer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/progress_bar_custom"
        app:layout_constraintTop_toBottomOf="@id/llQuizInfo"
        android:progress="100" />


    <TextView
        android:id="@+id/tvTimedQuizInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/quiz_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        app:layout_constraintTop_toBottomOf="@id/progressBarTimer"
        tools:text="What is the meaning of the word?" />

    <LinearLayout
        android:id="@+id/llQuizContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTimedQuizInstruction"
        app:layout_constraintBottom_toTopOf="@id/tvTimedQuizFeedback"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/mcSynAntQuizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMcSynAntWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/word"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/flMcSynAntOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/wcQuizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWcMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meaning_placeholder"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvWcMaskedWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/blank"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/flWcOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/spellingQuizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSpellingChallengeMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meaning_to_spell"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="24dp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flSpellingLetterBoxesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="center"
                app:alignItems="center" />

            <Button
                android:id="@+id/btnSpellingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_hint"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/quiz_hint_button_bg_soft"
                android:textColor="@color/quiz_hint_button_text_dark"
                android:textSize="16sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:elevation="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSpellingQuizSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_spelling"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_button_background"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:elevation="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvTimedQuizFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/feedback_placeholder"
        android:textColor="@color/quiz_text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/btnTimedQuizNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnTimedQuizNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/next_question"
        android:background="@drawable/rounded_button_background"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:paddingVertical="12dp"
        android:elevation="4dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>