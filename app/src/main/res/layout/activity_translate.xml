<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.TranslateActivity">
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_main"/>
    <LinearLayout
        android:id="@+id/languageSwap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_background"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="-14dp"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/inputLanguageLayout"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginHorizontal="5dp"
            android:padding="8dp"
            android:background="@drawable/rounded_background_blue"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/inputLanguageLogo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/ukFlagIconDescription"
                android:src="@drawable/uk_flag_round_circle_icon"/>
            <TextView
                android:id="@+id/inputLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/english"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/swapBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/swapIconDescription"
            android:src="@drawable/swap_24dp"
            android:layout_marginHorizontal="16dp"
            android:background="@android:color/transparent"/>
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginHorizontal="5dp"
            android:padding="8dp"
            android:background="@drawable/rounded_background"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/outputLanguageLogo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/pkFlagIconDescription"
                android:src="@drawable/pakistan_flag_round_circle_icon"/>
            <TextView
                android:id="@+id/outputLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/grey"
                android:text="@string/urdu"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_background"
        android:layout_margin="16dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:layoutDirection="ltr">
        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints=""
            android:hint="@string/typeHere"
            android:inputType="textMultiLine"
            android:textColor="@color/black"
            android:background="@color/white"
            android:layout_marginBottom="30dp"
            android:layout_marginTop="16dp"
            android:gravity="start|top"
            android:scrollbars="vertical"/>
        <ImageButton
            android:id="@+id/clearAllText"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@string/closeIconDescription"
            android:src="@drawable/close_24"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:background="@android:color/transparent" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">
            <ImageButton
                android:id="@+id/speechToTextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/micIconDescription"
                android:src="@drawable/mic_24dp"
                android:paddingHorizontal="8dp"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/copyEnglishBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copyIconDescription"
                android:src="@drawable/content_copy_24dp"
                android:paddingHorizontal="8dp"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/imageToTextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/OCRIconDescription"
                android:src="@drawable/document_scanner_24dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/outputTextLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_background"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:layoutDirection="ltr">
        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="30dp"
            android:textColor="@color/black"
            android:scrollbars="vertical"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">
            <ImageButton
                android:id="@+id/textToSpeachBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/speakerIconDescription"
                android:src="@drawable/text_to_speech_24dp"
                android:paddingHorizontal="8dp"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/copyUrduBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copyIconDescription"
                android:src="@drawable/content_copy_24dp"
                android:paddingHorizontal="8dp"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/shareUrduBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/shareIconDescription"
                android:src="@drawable/share_24dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </RelativeLayout>
    <Button
        android:id="@+id/translationBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_background"
        android:padding="8dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="16dp"
        android:text="@string/translate"
        android:textColor="@color/white"
        android:textAllCaps="false"/>
</LinearLayout>
