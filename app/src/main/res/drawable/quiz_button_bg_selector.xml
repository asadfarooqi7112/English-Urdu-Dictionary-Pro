<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="@color/quiz_option_bg_pressed"/>
            <stroke android:width="2dp" android:color="@color/quiz_option_border_pressed"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="@color/quiz_option_bg_default"/>
            <stroke android:width="1dp" android:color="@color/quiz_option_border_default"/>
        </shape>
    </item>
</selector>