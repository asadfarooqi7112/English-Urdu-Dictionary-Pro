<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quiz_option_selected_bg"/>
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/quiz_button_bg"/> </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quiz_option_selected_bg"/>
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/quiz_button_bg"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/quiz_option_default_bg"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="@color/quiz_option_border_default"/>
        </shape>
    </item>
</selector>